# Maxest batch 3: more filesystems and USB client/host classes.
# (Applied only after batch 2 gates; kept separate for attribution.)
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_2_INTER_SSC=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_JFS_FS=y
CONFIG_REISERFS_FS=y
CONFIG_HFS_FS=y
CONFIG_HFSPLUS_FS=y
CONFIG_UFS_FS=y
CONFIG_NILFS2_FS=y
CONFIG_ROMFS_FS=y
CONFIG_CRAMFS=y
CONFIG_ECRYPT_FS=y
CONFIG_OCFS2_FS=y
CONFIG_GFS2_FS=y
CONFIG_AFS_FS=y
CONFIG_CEPH_FS=y
CONFIG_SMB_SERVER=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_ACM=m
CONFIG_INPUT_UINPUT=y

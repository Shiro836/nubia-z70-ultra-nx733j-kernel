--- a/mm/vmstat.c
+++ b/mm/vmstat.c
@@ -108,17 +108,17 @@
 DEFINE_PER_CPU(struct vm_event_state, vm_event_states) = {{0}};
 EXPORT_PER_CPU_SYMBOL(vm_event_states);
 
-static void sum_vm_events(unsigned long *ret)
+static void sum_vm_events(unsigned long *ret, int n)
 {
 	int cpu;
 	int i;
 
-	memset(ret, 0, NR_VM_EVENT_ITEMS * sizeof(unsigned long));
+	memset(ret, 0, n * sizeof(unsigned long));
 
 	for_each_online_cpu(cpu) {
 		struct vm_event_state *this = &per_cpu(vm_event_states, cpu);
 
-		for (i = 0; i < NR_VM_EVENT_ITEMS; i++)
+		for (i = 0; i < n; i++)
 			ret[i] += this->event[i];
 	}
 }
@@ -131,11 +131,22 @@
 void all_vm_events(unsigned long *ret)
 {
 	cpus_read_lock();
-	sum_vm_events(ret);
+	/*
+	 * Keep the stock buffer contract: modules built before an event was
+	 * added size their buffer with the old NR_VM_EVENT_ITEMS.
+	 */
+	sum_vm_events(ret, NR_VM_EVENT_ITEMS_ABI);
 	cpus_read_unlock();
 }
 EXPORT_SYMBOL_GPL(all_vm_events);
 
+void all_vm_events_full(unsigned long *ret)
+{
+	cpus_read_lock();
+	sum_vm_events(ret, NR_VM_EVENT_ITEMS);
+	cpus_read_unlock();
+}
+
 /*
  * Fold the foreign cpu events into our own.
  *
@@ -1829,7 +1840,7 @@
